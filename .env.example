# Vercel Blob Read-Write Token
# Automatically populated by Vercel when connecting a Blob store to your project.
# To pull down locally for development: npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: Admin Secret Key for API protection
# If set in production, mutations (POST, PATCH, DELETE, upload token generation) require
# the 'x-admin-secret' request header to match this value.
ADMIN_SECRET_KEY="your-secure-admin-secret"
